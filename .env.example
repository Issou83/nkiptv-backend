# ═══════════════════════════════════════════════════
#   NKiptv Backend — Variables d'environnement
# ═══════════════════════════════════════════════════

# ── Serveur ──────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── MongoDB Atlas ─────────────────────────────────
# Créez un cluster gratuit sur https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/nkiptv?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────
JWT_SECRET=votre_secret_jwt_minimum_32_caracteres_ici
JWT_REFRESH_SECRET=votre_refresh_secret_different_du_premier
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d

# ── CORS ─────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# En prod: FRONTEND_URL=https://nkiptv.vercel.app

# ── Stripe Paiements ─────────────────────────────
# Créez un compte sur https://stripe.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PREMIUM=price_...
STRIPE_PRICE_PRO=price_...

# ── Email (Nodemailer) ───────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre@email.com
SMTP_PASS=votre_mot_de_passe_app
EMAIL_FROM=NKiptv <noreply@nkiptv.fr>

# ── Admin ─────────────────────────────────────────
ADMIN_EMAIL=admin@nkiptv.fr
ADMIN_PASSWORD=your_secure_admin_password_here

# ── Sources IPTV ─────────────────────────────────
IPTV_ORG_API=https://iptv-org.github.io/api
SYNC_INTERVAL_HOURS=12

# ── URLs de l'app ─────────────────────────────────
APP_URL=http://localhost:3001
# En prod: APP_URL=https://api-nkiptv.vercel.app
